{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude_md_before_push.sh\"",
            "timeout": 15,
            "statusMessage": "Checking CLAUDE.md is updated before push"
          }
        ]
      }
    ]
  }
}
