# Copy to .env and adjust. Any value left unset falls back to a sane local-dev default.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# In production behind a proxy that terminates TLS (e.g. Railway), also set:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# HSTS (only applied when DJANGO_DEBUG=False). Start low, raise once HTTPS
# is confirmed solid on every domain in use — see config/settings.py.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# DATABASE_URL (as Railway's Postgres plugin provides) takes priority if
# set. Otherwise, leave POSTGRES_DB unset to use local SQLite (fine for
# dev, per SPEC.md §7), or set the split POSTGRES_* vars below.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Defaults to printing emails to the console. Point at the charity's SMTP
# account/relay in production (§5.3, §7).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@passports.makeyourmark.co.uk

# Resend (https://resend.com), used directly via its API for the submission
# confirmation email (§5.3) -- see passports/resend_client.py. Leave blank to
# have it log instead of sending real email.
RESEND_API_KEY=

# Needed for links built outside a request (e.g. bulk-email unsubscribe
# links) -- falls back to the first CSRF-trusted origin if unset.
DJANGO_PUBLIC_BASE_URL=
